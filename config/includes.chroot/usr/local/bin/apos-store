#!/usr/bin/env python3
"""
ApOS Store — собственный магазин приложений.
Простая витрина с категориями, поиском и установкой через apt/flatpak.
"""
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib
import subprocess
import threading

CSS = b"""
window { background-color: #11131f; }
headerbar {
    background-color: #181a2b;
    color: #e6e8f5;
    border-bottom: 1px solid #2a2d45;
}
headerbar .title { font-weight: 700; color: #e6e8f5; }
.sidebar {
    background-color: #14162a;
    border-right: 1px solid #2a2d45;
}
.sidebar row { padding: 10px 14px; color: #b3b8dd; }
.sidebar row:selected { background-color: #3552c9; color: white; border-radius: 6px; }
.app-card {
    background-color: #181a2b;
    border-radius: 12px;
    padding: 14px;
    margin: 6px;
    border: 1px solid #262a45;
}
.app-card:hover { border-color: #3552c9; }
.app-title { font-weight: 700; font-size: 14px; color: #eef0fb; }
.app-desc { font-size: 12px; color: #9aa0c8; }
button.install-btn {
    background: linear-gradient(180deg, #7aa2f7, #5b7fe0);
    color: white;
    border-radius: 8px;
    padding: 4px 14px;
    border: none;
}
button.install-btn:hover { background: #6b93ee; }
searchentry, entry {
    background-color: #181a2b;
    color: #e6e8f5;
    border-radius: 8px;
    border: 1px solid #2a2d45;
}
"""

CATALOG = {
    "Рекомендуемое": [
        ("Chromium", "Быстрый браузер на движке Blink", "chromium"),
        ("LibreOffice", "Полный офисный пакет", "libreoffice"),
        ("VLC", "Проигрыватель почти любых форматов видео", "vlc"),
    ],
    "Графика": [
        ("GIMP", "Мощный редактор растровой графики", "gimp"),
        ("Inkscape", "Векторная графика", "inkscape"),
        ("Krita", "Рисование и цифровая живопись", "krita"),
    ],
    "Разработка": [
        ("Git", "Система контроля версий", "git"),
        ("VS Code (Flatpak)", "Редактор кода", "flatpak:com.visualstudio.code"),
        ("Build Essential", "Компиляторы и инструменты сборки", "build-essential"),
    ],
    "Windows-приложения": [
        ("Wine", "Запуск Windows-программ в ApOS", "wine"),
        ("Winetricks", "Установка библиотек для Wine", "winetricks"),
        ("PlayOnLinux", "Графический менеджер Windows-программ", "playonlinux"),
    ],
    "Игры": [
        ("Steam", "Игровая платформа Steam", "steam-installer"),
        ("Lutris", "Менеджер игр (Windows/Linux)", "lutris"),
    ],
}


def install_package(pkg, done_callback):
    def worker():
        try:
            if pkg.startswith("flatpak:"):
                app_id = pkg.split(":", 1)[1]
                subprocess.run(["flatpak", "install", "-y", "flathub", app_id], check=True)
            else:
                subprocess.run(["pkexec", "apt", "install", "-y", pkg], check=True)
            GLib.idle_add(done_callback, True, "")
        except subprocess.CalledProcessError as e:
            GLib.idle_add(done_callback, False, str(e))
    threading.Thread(target=worker, daemon=True).start()


class AppCard(Gtk.Box):
    def __init__(self, name, desc, pkg):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.get_style_context().add_class("app-card")

        icon = Gtk.Image.new_from_icon_name("application-x-executable-symbolic", Gtk.IconSize.DND)
        self.pack_start(icon, False, False, 0)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label=name, xalign=0)
        title.get_style_context().add_class("app-title")
        desc_label = Gtk.Label(label=desc, xalign=0)
        desc_label.get_style_context().add_class("app-desc")
        desc_label.set_line_wrap(True)
        text_box.pack_start(title, False, False, 0)
        text_box.pack_start(desc_label, False, False, 0)
        self.pack_start(text_box, True, True, 0)

        self.install_btn = Gtk.Button(label="Установить")
        self.install_btn.get_style_context().add_class("install-btn")
        self.install_btn.connect("clicked", self.on_install, pkg)
        self.pack_end(self.install_btn, False, False, 0)

    def on_install(self, widget, pkg):
        self.install_btn.set_label("Установка...")
        self.install_btn.set_sensitive(False)
        install_package(pkg, self.on_done)

    def on_done(self, success, error):
        self.install_btn.set_label("Готово ✓" if success else "Ошибка")
        if not success:
            self.install_btn.set_sensitive(True)
            self.install_btn.set_label("Повторить")


class ApOSStore(Gtk.Window):
    def __init__(self):
        super().__init__(title="Магазин приложений ApOS")
        self.set_default_size(820, 540)

        header = Gtk.HeaderBar(title="Магазин приложений ApOS")
        header.set_show_close_button(True)
        self.set_titlebar(header)

        self.search = Gtk.SearchEntry(placeholder_text="Поиск приложений...")
        self.search.connect("search-changed", self.on_search)
        header.pack_start(self.search)

        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(main_box)

        self.sidebar = Gtk.ListBox()
        self.sidebar.get_style_context().add_class("sidebar")
        self.sidebar.connect("row-selected", self.on_category_selected)
        for category in CATALOG:
            row = Gtk.ListBoxRow()
            label = Gtk.Label(label=category, xalign=0)
            row.add(label)
            self.sidebar.add(row)

        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_size_request(200, -1)
        sidebar_scroll.add(self.sidebar)
        main_box.pack_start(sidebar_scroll, False, False, 0)

        self.content_scroll = Gtk.ScrolledWindow()
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.content_scroll.add(self.content_box)
        main_box.pack_start(self.content_scroll, True, True, 0)

        self.sidebar.select_row(self.sidebar.get_row_at_index(0))

    def on_category_selected(self, box, row):
        if row is None:
            return
        category = list(CATALOG.keys())[row.get_index()]
        self.show_apps(CATALOG[category])

    def on_search(self, entry):
        query = entry.get_text().lower()
        if not query:
            self.on_category_selected(self.sidebar, self.sidebar.get_selected_row())
            return
        results = []
        for apps in CATALOG.values():
            for app in apps:
                if query in app[0].lower() or query in app[1].lower():
                    results.append(app)
        self.show_apps(results)

    def show_apps(self, apps):
        for child in self.content_box.get_children():
            self.content_box.remove(child)
        for name, desc, pkg in apps:
            self.content_box.pack_start(AppCard(name, desc, pkg), False, False, 0)
        self.content_box.show_all()


def main():
    screen = Gdk.Screen.get_default()
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = ApOSStore()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
