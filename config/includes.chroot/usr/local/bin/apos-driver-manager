#!/bin/bash
# ApOS Driver Manager — определяет видеокарту и предлагает поставить
# проприетарный драйвер NVIDIA, если он нужен.

RESULT=$(nvidia-detect 2>/dev/null)

if echo "$RESULT" | grep -qi "recommended"; then
    DRIVER=$(echo "$RESULT" | grep -oP 'nvidia-driver\S*' | head -n1)
    if zenity --question --title="Диспетчер драйверов ApOS" \
        --text="Обнаружена NVIDIA. Рекомендуемый драйвер: ${DRIVER:-nvidia-driver}\n\nУстановить его?" \
        --width=400; then
        pkexec bash -c "apt update && apt install -y ${DRIVER:-nvidia-driver}"
        zenity --info --text="Готово. Перезагрузите систему, чтобы применить драйвер." --width=350
    fi
else
    zenity --info --title="Диспетчер драйверов ApOS" \
        --text="Дополнительные проприетарные драйверы не требуются — используется открытый драйвер." \
        --width=350
fi
